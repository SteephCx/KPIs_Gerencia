
@model kpi_logs

@{
    ViewData["Title"] = "Crear Captura de KPIs";
}

<h1>Crear nueva captura</h1>
<h5>Captura tus indicadores en forma ordenada</h5>
<p>Numero Empleado: @ViewBag.NoEmpleado</p>
<p>Nombre: @ViewBag.NombreEmpleado</p>
<p>Apellido: @ViewBag.ApellidoEmpleado</p>
<p>Departamento: @ViewBag.Departamento</p>


<from asp-controller="CapturaKPIs">
    <div class="mb-3">
        <label for="KPI 1">KPI 1 </label>
        <input type="number" id="KPI 1" class="form-control" />

        <label for="KPI 2">KPI 2 </label>
        <input type="number" id="KPI 2" class="form-control" />

        <label for="KPI 3">KPI 3 </label>
        <input type="number" id="KPI 3" class="form-control" />


        <button>ingresar</button>

    </div>
</from>








