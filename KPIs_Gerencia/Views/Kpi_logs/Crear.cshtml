
@model kpi_logs

@{
    ViewData["Title"] = "Crear Captura de KPIs";
}
<link rel="stylesheet" href="~/css/crear.css">
<div class="centrar-en-pantalla">
 <div class="container text-center">
    <h1 class="titulos">CAPTURA DE KPIs</h1>
    <h5 class="titulos">Capture su número de empleado</h5>

    <form method="get" asp-controller="Kpi_logs" asp-action="ConsultarNoempleado" class="formulario row g-3 justify-content-center">
    <div class="col-auto">
        <label for="NO_EMPLEADO" class="visually-hidden">Número de empleado</label>
        <input type="text" readonly class="form-control-plaintext" id="NO_EMPLEADO" value="Número de empleado">
    </div>
    <div class="col-auto">
        <label for="NO_EMPLEADO" class="visually-hidden">No empleado</label>
        <input type="number" name="NO_EMPLEADO" id="NO_EMPLEADO" placeholder="Ingrese el número de empleado" required />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary mb-3">Introducir</button>
    </div>
</form>

  </div>
  </div>







